# Copy to .env and fill in. Never put real secrets in this file — it is committed to git.

# ── Supabase (Project Settings → API) ──
# Service-role / secret key: server only, bypasses RLS.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# ── Site ──
# Public URL of the site (used in email links).
SITE_URL=http://localhost:8000
# How often the keep-alive loop touches the database (seconds).
KEEPALIVE_INTERVAL_SECONDS=3600

# ── Admin ──
# Comma-separated addresses that get order notifications.
ADMIN_EMAILS=admin@example.com
# Password for the /admin page.
ADMIN_PASSWORD=
# Long random string used to sign admin sessions and email links.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── Email (Brevo → SMTP & API → API keys) ──
# Leave BREVO_API_KEY empty in dev: emails are printed to the console instead.
BREVO_API_KEY=
# Must be a sender verified in Brevo (Senders, domains & dedicated IPs).
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Beautiful Nothing
# Optional: where buyers' replies go (e.g. the author's personal inbox).
MAIL_REPLY_TO=

# ── Book & sales ──
# These (and ADMIN_EMAILS, the sales phase and the Selar/Drive links below) are only starting values.
# Once the site runs, change them in /admin → Settings; saved values there win over this file.
# Pickup locations are managed in /admin → Settings too (PICKUP_STORE is only a fallback).
PICKUP_STORE=Store address shown to buyers who choose pickup
PAPERBACK_DELIVERY_PRICE=12000
PAPERBACK_PICKUP_PRICE=10000
LAUNCH_GIFT_MINIMUM=5000
EBOOK_PRICE=5000
# Short area name shown on the landing page next to the pickup price.
PICKUP_AREA=Opebi, Ikeja

# ── Sales phase & Selar links ──
# launch  = page leads with "Show love";  regular = page sells the ebook (after launch).
SALES_PHASE=launch
SHOWLOVE_URL=
EBOOK_URL=

# ── Selar ──
SELARA_API_KEY=

# Google Drive link to the ebook, emailed to "show love" gifters when you click Thank in /admin.
# In Drive: right-click the file → Share → General access: "Anyone with the link" (Viewer) → Copy link.
EBOOK_GIFT_DRIVE_LINK=
