# Supabase project → Settings → API. Use the service-role key: it stays on the server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# How often the keep-alive loop touches the database (seconds). Supabase free tier
# pauses after ~7 days of inactivity; hourly is plenty.
KEEPALIVE_INTERVAL_SECONDS=3600
